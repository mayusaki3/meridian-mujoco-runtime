<?xml version="1.0"?>
<robot name="slider">
  <link name="base"/>
  <link name="slider"><visual><geometry><sphere radius="0.06"/></geometry></visual></link>
  <link name="tool"/>
  <joint name="linear_axis" type="prismatic"><parent link="base"/><child link="slider"/><axis xyz="1 0 0"/><limit lower="0" upper="0.3" effort="50" velocity="0.5"/></joint>
  <joint name="tool_mount" type="fixed"><parent link="slider"/><child link="tool"/><origin xyz="0.1 0 0"/></joint>
</robot>
